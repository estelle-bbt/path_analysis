tidyr::drop_na()
psem_proxy <- piecewiseSEM::psem(lme4::lmer(data=data_complete,formula1),
lme4::lmer(data=data_complete,formula2),
lme4::lmer(data=data_complete,formula3),
lme4::lmer(data=data_complete,formula4),
lme4::lmer(data=data_complete,formula5),
lme4::lmer(data=data_complete,formula6),
lme4::lmer(data=data_complete,formula7))
summary <- summary(psem_proxy)
