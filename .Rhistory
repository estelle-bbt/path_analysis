m2 <- lme4::lmer(formula2, data = data_target)
m3 <- lme4::lmer(formula3, data = data_target)
m4 <- lme4::lmer(formula4, data = data_target)
m5 <- lme4::lmer(formula5, data = data_target)
m6 <- lme4::lmer(formula6, data = data_target)
m7 <- lme4::lmer(formula7, data = data_target)
summary(m1)
summary(m2)
summary(m2)
summary(m3)
summary(m4)
summary(m5)
summary(m6)
summary(m7)
sapply(
list(m1,m2,m3,m4,m5,m6,m7),
lme4::isSingular
)
piecewiseSEM::psem(m1)
piecewiseSEM::psem(m1,m2)
piecewiseSEM::psem(m1,m2,m3)
piecewiseSEM::psem(m1,m2,m3,m4)
piecewiseSEM::psem(m1,m2,m3,m4,m5)
piecewiseSEM::psem(m1,m2,m3,m4,m5,m6)
piecewiseSEM::psem(m1,m2,m3,m4,m5,m6,m7)
